<?xml version="1.0" encoding="utf-8"?>
<!--
  同步服务：https://sync.knowhub.chat:18443
  证书：Let's Encrypt（DNS-01 验证，公信 CA）
  系统内置信任链自动验证，无需 trust-anchors 覆盖。

  base-config 禁止明文流量：任何走 http:// 的意外降级都会被系统直接拒绝。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
