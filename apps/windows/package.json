{
  "name": "timemark-windows",
  "version": "0.5.1",
  "private": true,
  "description": "TimeMark 时光标 - Windows 桌面端（M1 本地版）",
  "main": "dist/main/electron/main.js",
  "author": "TimeMark",
  "scripts": {
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:main",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test:build": "tsc -p tsconfig.main.json",
    "pretest": "tsc -p tsconfig.main.json",
    "test": "node --test tests/contract.test.cjs tests/engine.test.cjs tests/date-logic.test.cjs tests/repo-guard.test.cjs",
    "lint": "eslint . --max-warnings 0",
    "version:sync": "node ../../tools/version.mjs --write",
    "version:check": "node ../../tools/version.mjs",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "pack:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.timemark.windows",
    "productName": "TimeMark",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TimeMark 时光标"
    },
    "portable": {
      "artifactName": "TimeMark-Portable-${version}.exe"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^37.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.12.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.12.0"
  }
}
