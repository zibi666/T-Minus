# 裸 IP 场景（无域名）：Caddy 内部 CA 终结 TLS，后端只听 127.0.0.1:18080
# 用法与客户端根证书投放见 deploy/TLS-CUTOVER.md 第 2 节。

{
	# 内部 CA 的根证书要导出给两端内置；有效期拉长到 10 年，避免客户端集体过期
	local_certs
	skip_install_triggers
}

# IP 作为 SNI 不合法，因此用 https://timemark.local 这种伪域名 + 客户端 DNS/hosts 映射，
# 或直接信任根 CA 并按 IP 访问（Caddy 的 internal issuer 支持 IP 证书）。
timemark.local, 118.195.133.25 {
	tls internal
	encode gzip

	# 登录/注册限速：避免脚本撞库与批量注册
	@auth path /api/v1/auth/*
	rate_limit {
		@auth {
			group auth
			window 1m
			window_size 5
			burst 5
			retry_after 30s
		}
	}

	handle {
		reverse_proxy 127.0.0.1:18080 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto https
		}
	}
}
